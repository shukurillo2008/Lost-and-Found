# Public HTTPS entry point for the Campus Lost & Found office UI.
#
# Caddy obtains and renews the certificate automatically for a real domain.
# The domain comes from LNF_DOMAIN in .env (or the shell).
#
# Start it with:
#   docker compose -f docker-compose.yml -f deploy/docker-compose.prod.yml up -d --build

{$LNF_DOMAIN:localhost} {
	encode zstd gzip

	# Django (gunicorn) listens on web:8000 inside the Compose network.
	reverse_proxy web:8000

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
}
