# Campus Lost & Found - runtime configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Django web service ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_TIMEZONE=Asia/Tashkent

# --- Telegram bot service ---
BOT_TOKEN=123456789:AAAA-your-telegram-bot-token-here
OFFICE_GROUP_ID=-1001234567890

# --- Office superuser for /admin (seed_demo creates it if set) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-office-password

# --- Storage paths (docker values; adjust for local dev) ---
SQLITE_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# --- Worker service ---
WORKER_MATCH_INTERVAL_MINUTES=10
WORKER_DIGEST_HOUR=9

# --- Automatic translation of reference data (admin saves / seed) ---
# When true, blank *_en / *_ru / *_uz fields are filled via an online
# translator. Set to False for fully offline operation.
AUTO_TRANSLATE=True
